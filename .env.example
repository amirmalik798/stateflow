# Frontend/server same-origin deployment
APP_ORIGIN="https://your-stateflow-domain.example"

# PostgreSQL connection string from Render or another managed PostgreSQL provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stateflow"
PG_POOL_SIZE="10"
PG_SSL="true"

# Google OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Optional existing AI feature configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
