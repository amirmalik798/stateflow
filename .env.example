# Local development: connect directly to PostgreSQL on this machine.
APP_ORIGIN="http://localhost:3000"
DATABASE_URL="postgresql://stateflow_sync:URL_ENCODED_PASSWORD@127.0.0.1:5432/stateflow"
PG_POOL_SIZE="4"
PG_SSL="false"

# Optional Tailscale route used by the Render deployment.
# DATABASE_URL should point to the loopback forwarder (127.0.0.1:15432).
PG_TAILSCALE_TARGET_HOST=""
PG_TAILSCALE_TARGET_PORT="5432"
PG_TAILSCALE_LOCAL_PORT="15432"
PG_TAILSCALE_SOCKS_PORT="1055"

# Render/Tailscale secrets (set in the Render Dashboard; never commit actual values).
TAILSCALE_AUTH_KEY=""
TAILSCALE_HOSTNAME="stateflow-render"

# Google OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Optional existing AI feature configuration.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
