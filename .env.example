# Local development. Use a strong private password; never commit your real .env file.
APP_ORIGIN="http://localhost:3000"
DATABASE_URL="postgresql://stateflow_sync:URL_ENCODED_PASSWORD@127.0.0.1:5432/stateflow"
PG_POOL_SIZE="4"
PG_SSL="false"

# Single-user personal login. Configure these as private environment variables on Render.
STATEFLOW_LOGIN_ID="owner"
STATEFLOW_LOGIN_PASSWORD="REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"

# Optional existing AI feature configuration.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
